{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "oxc"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",

    // Remaining findings are intentional patterns (mirroring browser speech recognition into
    // editable inputs, a ref mirror for live-voice callbacks); kept visible as warnings.
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  },
  "ignorePatterns": ["dist/**", "dev-dist/**", "node_modules/**"]
}
